{
  "version": 2,
  "routes": [
    {
      "src": "/api/heartbeat",
      "dest": "/api/heartbeat.js",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/stats",
      "dest": "/api/stats.js",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/api/force-update",
      "dest": "/api/force-update.js",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/admin(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
